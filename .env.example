# Copy to .env for local development: cp .env.example .env
# Process and container environment variables take precedence over this file.

# Comma-separated bearer tokens for authenticated routes. Replace the example
# value with long random tokens, for example: openssl rand -hex 32
VALID_API_KEYS=replace-with-a-long-random-token

# development keeps Swagger at /docs; production (or Cloud Run's K_SERVICE)
# serves only ReDoc.
OPENFPL_ENV=development

# Canonical site URL used in robots.txt and sitemap.xml.
OPENFPL_SITE_URL=http://localhost:8000

# FPL Data enrichment. Set false for an immediate kill switch.
FPL_DATA_INFERENCE_ENABLED=true
# Downloads from FPL Data are acknowledged in config/config.yaml; set false to
# use only files imported with scripts.download_fpl_data.
FPL_DATA_ACKNOWLEDGE_PERMISSION_PENDING=true

# Training archive. Set OPENFPL_DATA_ROOT when the data volume is not mounted at
# ./data (for example /data on Cloud Run); it moves the archive and the FPL Data
# cache together. OPENFPL_DATA_ARCHIVE_ROOT moves only the archive.
OPENFPL_DATA_ARCHIVE_ENABLED=true
# OPENFPL_DATA_ROOT=/data
# OPENFPL_DATA_ARCHIVE_ROOT=/data/archive
